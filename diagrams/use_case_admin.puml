@startuml Use Case - Modul Administratora - Pionowy

' Ustawienie domyslne (gora-dol), ale wymusimy kolejnosc
top to bottom direction

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightBlue
    BorderColor DarkBlue
}
skinparam rectangle {
    BackgroundColor #F5F5FF
    BorderColor DarkBlue
}

title Diagram Przypadków Użycia\nModuł Administratora

actor "Administrator" as Admin #LightBlue

rectangle "System QRWare - Moduł Administratora" {
    
    package "1. Zarządzanie Produktami" {
        usecase "UC-A01: Zarządzanie\nproduktami" as UC_A01
        usecase "UC-A02: Zarządzanie\nkategoriami" as UC_A02
    }
    
    package "2. Zarządzanie Magazynem" {
        usecase "UC-A03: Definiowanie\nstref magazynowych" as UC_A03
        usecase "UC-A04: Definiowanie\nlokalizacji" as UC_A04
    }
    
    package "3. Monitoring" {
        usecase "UC-A05: Podgląd historii\noperacji magazynowych" as UC_A05
    }
    
    package "4. Zarządzanie Uprawnieniami" {
        usecase "UC-A06: Zarządzanie\nrolami systemowymi" as UC_A06
        usecase "UC-A07: Zarządzanie\nużytkownikami" as UC_A07
    }
    
    usecase "Logowanie" as Login
    usecase "Wylogowanie" as Logout
}

' Relacje aktora (zwykłe)
Admin --> UC_A01
Admin --> UC_A02
Admin --> UC_A03
Admin --> UC_A04
Admin --> UC_A05
Admin --> UC_A06
Admin --> UC_A07
Admin --> Login
Admin --> Logout

' === SEKCJA LAYOUT (Wymuszanie pionu) ===
' Te linie sa niewidoczne, ale ustawiaja pakiety jeden pod drugim
UC_A01 -[hidden]-> UC_A03
UC_A03 -[hidden]-> UC_A05
UC_A05 -[hidden]-> UC_A06
' Odsuniecie logowania na bok lub dol
UC_A07 -[hidden]-> Login

@enduml