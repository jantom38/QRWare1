@startuml Use Case - Modul Menadzera

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}
skinparam rectangle {
    BackgroundColor #F5FFF5
    BorderColor DarkGreen
}

title Diagram Przypadkow Uzycia\nModul Menadzera

actor "Menadzer" as Manager #LightGreen

rectangle "System QRWare - Modul Menadzera" {
    
    package "Raportowanie" {
        usecase "UC-M01: Tworzenie raportow\no stanach magazynowych" as UC_M01
        usecase "UC-M07: Podglad procesow\nlogistycznych" as UC_M07
    }
    
    package "Zarzadzanie Stanami" {
        usecase "UC-M02: Tworzenie stanow\nmagazynowych" as UC_M02
        usecase "UC-M05: Generowanie\nkodow QR" as UC_M05
    }
    
    package "Zarzadzanie Zleceniami" {
        usecase "UC-M03: Tworzenie zlecen\nmagazynowych" as UC_M03
        usecase "UC-M04: Monitorowanie\nstatusu zlecen" as UC_M04
    }
    
    package "Operacje QR" {
        usecase "UC-M06: Skanowanie\nkodow QR" as UC_M06
    }
    
    usecase "Logowanie" as Login
    usecase "Wylogowanie" as Logout
}

' Relacje aktora
Manager --> UC_M01
Manager --> UC_M02
Manager --> UC_M03
Manager --> UC_M04
Manager --> UC_M05
Manager --> UC_M06
Manager --> UC_M07
Manager --> Login
Manager --> Logout

' Relacje miedzy UC
UC_M02 ..> UC_M05 : <<include>>\nauto-generowanie QR
UC_M04 ..> UC_M03 : <<extend>>\nmonitorowanie po utworzeniu

note right of UC_M01
  **Typy raportow:**
  - Stany magazynowe
  - Niski stan (alerty)
  - Przeplywy produktow
  - Wartosc zapasow
  - Produkty przeterminowane
  --
  **Eksport:** PDF, Excel
end note

note right of UC_M03
  **Typy zlecen:**
  - INBOUND (przyjecie)
  - OUTBOUND (wydanie)
  - TRANSFER (przeniesienie)
  - PICK (kompletacja)
  --
  **Priorytety:**
  LOW, NORMAL, HIGH, URGENT
end note

note bottom of UC_M04
  **Statusy zlecen:**
  - CREATED
  - ASSIGNED
  - IN_PROGRESS
  - PARTIALLY_COMPLETED
  - COMPLETED
  - CANCELLED
end note

note right of UC_M05
  **Typy kodow QR:**
  - PRODUCT
  - INVENTORY
  - LOCATION
  --
  Format: PNG
  Gotowe do wydruku
end note

@enduml
