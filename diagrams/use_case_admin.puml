@startuml Use Case - Modul Administratora

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightBlue
    BorderColor DarkBlue
}
skinparam rectangle {
    BackgroundColor #F5F5FF
    BorderColor DarkBlue
}

title Diagram Przypadkow Uzycia\nModul Administratora

actor "Administrator" as Admin #LightBlue

rectangle "System QRWare - Modul Administratora" {
    
    package "Zarzadzanie Produktami" {
        usecase "UC-A01: Zarzadzanie\nproduktami (CRUD)" as UC_A01
        usecase "UC-A02: Zarzadzanie\nkategoriami" as UC_A02
    }
    
    package "Zarzadzanie Magazynem" {
        usecase "UC-A03: Definiowanie\nstref magazynowych" as UC_A03
        usecase "UC-A04: Definiowanie\nlokalizacji" as UC_A04
    }
    
    package "Monitoring" {
        usecase "UC-A05: Podglad historii\noperacji magazynowych" as UC_A05
    }
    
    package "Zarzadzanie Uprawnieniami" {
        usecase "UC-A06: Zarzadzanie\nrolami systemowymi" as UC_A06
        usecase "UC-A07: Zarzadzanie\nuzytkownikami" as UC_A07
    }
    
    usecase "Logowanie" as Login
    usecase "Wylogowanie" as Logout
}

' Relacje aktora
Admin --> UC_A01
Admin --> UC_A02
Admin --> UC_A03
Admin --> UC_A04
Admin --> UC_A05
Admin --> UC_A06
Admin --> UC_A07
Admin --> Login
Admin --> Logout

' Relacje miedzy UC
UC_A04 ..> UC_A03 : <<include>>\nwymaga istnienia strefy
UC_A01 ..> UC_A02 : <<include>>\nwymaga kategorii
UC_A07 ..> UC_A06 : <<include>>\nwymaga istnienia roli

note right of UC_A01
  **Operacje CRUD:**
  - Tworzenie produktu
  - Odczyt danych
  - Aktualizacja
  - Usuwanie
  --
  **Atrybuty:**
  nazwa, SKU, jednostka,
  wilgotnosc, min/max stan
end note

note right of UC_A03
  **Typy stref:**
  - RECEIVING (przyjecia)
  - STORAGE (magazyn)
  - COLD_STORAGE (chlodnia)
  - SHIPPING (wysylka)
  - QUARANTINE (kwarantanna)
end note

note bottom of UC_A06
  **Przykladowe role:**
  - Administrator
  - Menadzer
  - Magazynier
  --
  **Uprawnienia:**
  products:create
  inventory:read
  orders:update
end note

@enduml
