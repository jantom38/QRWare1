@startuml Activity Diagram - Przeplyw zlecenia

!theme plain
skinparam activityDiamondBackgroundColor LightYellow
skinparam activityBackgroundColor LightBlue

title Diagram Aktywnosci - Przeplyw realizacji zlecenia magazynowego

|#LightGreen|Menadzer|
|#LightBlue|System|
|#LightYellow|Magazynier|

|Menadzer|
start
:Identyfikacja potrzeby\n(dostawa/zamowienie/przeniesienie);

:Wybor typu zlecenia;
note right
  INBOUND - przyjecie
  OUTBOUND - wydanie
  TRANSFER - przeniesienie
  PICK - kompletacja
end note

:Dodanie pozycji zlecenia\n(produkty, ilosci, lokalizacje);

:Okreslenie priorytetu\ni terminu realizacji;

if (Przypisac do magazyniera?) then (tak)
    :Wybor magazyniera;
    |System|
    :Zmiana statusu na ASSIGNED;
    :Wyslanie powiadomienia\ndo magazyniera;
else (nie)
    |System|
    :Zmiana statusu na CREATED;
    :Dodanie do puli zlecen;
endif

|System|
:Zapisanie zlecenia\nw bazie danych;

|Magazynier|
:Przeglad dostepnych/\nprzypisanych zlecen;

:Wybor zlecenia\ndo realizacji;

|System|
:Zmiana statusu na IN_PROGRESS;
:Zapis w historii statusow;

|Magazynier|

repeat
    :Pobranie kolejnej pozycji\nzlecenia;
    
    :Przejscie do lokalizacji\nzrodlowej;
    
    :Skanowanie QR lokalizacji;
    
    |System|
    if (Lokalizacja poprawna?) then (tak)
        :Potwierdzenie lokalizacji;
    else (nie)
        :Komunikat o bledzie;
        |Magazynier|
        :Przejscie do wlasciwej\nlokalizacji;
        |System|
    endif
    
    |Magazynier|
    :Skanowanie QR produktu/stanu;
    
    |System|
    if (Produkt poprawny?) then (tak)
        :Wyswietlenie danych produktu;
    else (nie)
        :Komunikat o bledzie;
        |Magazynier|
        :Znalezienie wlasciwego\nproduktu;
        |System|
    endif
    
    |Magazynier|
    :Wprowadzenie ilosci;
    
    |System|
    if (Ilosc dostepna?) then (tak)
        :Aktualizacja stanu\nmagazynowego;
        :Rejestracja ruchu\nw historii;
        :Aktualizacja statusu\npozycji na COMPLETED;
    else (nie)
        if (Czesciowa realizacja?) then (tak)
            :Aktualizacja z dostepna\niloscia;
            :Status pozycji:\nPARTIALLY_COMPLETED;
        else (nie)
            :Status pozycji: SKIPPED;
            :Rejestracja braku;
        endif
    endif
    
    |Magazynier|
    
repeat while (Kolejna pozycja?) is (tak)
->nie;

:Zakonczenie zlecenia;

|System|
if (Wszystkie pozycje\nzrealizowane?) then (tak)
    :Status zlecenia: COMPLETED;
else (nie)
    :Status zlecenia:\nPARTIALLY_COMPLETED;
    
    |Menadzer|
    :Przeglad niezrealizowanych\npozycji;
    
    if (Utworzyc nowe zlecenie\nna braki?) then (tak)
        :Utworzenie zlecenia\nuzupelniajacego;
    else (nie)
        :Zamkniecie z brakami;
    endif
endif

|System|
:Zapisanie daty zakonczenia;
:Aktualizacja historii statusow;

|Menadzer|
:Przeglad raportu\nz realizacji;

if (Wymagane dzialania\nkorygujace?) then (tak)
    :Analiza przyczyn;
    :Utworzenie korekty\nlub reklamacji;
else (nie)
endif

stop

@enduml
