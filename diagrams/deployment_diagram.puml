@startuml Deployment Diagram - QRWare

!theme plain
skinparam node {
    BackgroundColor LightYellow
}
skinparam artifact {
    BackgroundColor LightBlue
}
skinparam database {
    BackgroundColor LightGreen
}

title Diagram Wdrozenia - Infrastruktura QRWare

' ==================== URZADZENIA MOBILNE ====================
node "Urzadzenie Mobilne Android" as mobile {
    artifact "QRWare App\n(Kotlin/Compose)" as app {
        component [UI Screens]
        component [ViewModels]
        component [Repositories]
        component [API Service]
        component [QR Scanner]
        component [Token Manager]
    }
    
    artifact "Android OS" as android
}

' ==================== SERWER APLIKACJI ====================
node "Serwer Aplikacji" as appserver {
    artifact "JVM (Java 17+)" as jvm {
        artifact "Spring Boot Application" as spring {
            component [REST Controllers]
            component [Security Layer]
            component [Business Services]
            component [JPA Repositories]
            component [QR Generator]
        }
    }
    
    artifact "File System" as fs {
        folder "uploads" {
            folder "qr-codes" as qrfolder
        }
    }
}

' ==================== SERWER BAZY DANYCH ====================
node "Serwer Bazy Danych" as dbserver {
    database "PostgreSQL" as postgres {
        [users]
        [roles]
        [products]
        [categories]
        [inventory_items]
        [orders]
        [locations]
        [zones]
        [movement_history]
        [qr_codes]
    }
}

' ==================== DRUKARKA ====================
node "Drukarka Etykiet" as printer {
    artifact "Drukarka termiczna\nlub laserowa"
}

' ==================== POLACZENIA ====================
mobile --> appserver : HTTPS\n(REST API)\nport 8080
appserver --> dbserver : JDBC\nport 5432
spring --> fs : File I/O
mobile ..> printer : Bluetooth/WiFi\n(opcjonalnie)

' ==================== NOTATKI ====================
note right of mobile
  **Wymagania:**
  - Android 8.0+
  - Kamera do skanowania QR
  - Polaczenie sieciowe
end note

note right of appserver
  **Konfiguracja:**
  - Spring Boot 3.x
  - Spring Security + JWT
  - Spring Data JPA
  - Flyway (migracje)
  - ZXing (QR)
end note

note right of dbserver
  **Baza danych:**
  - PostgreSQL 14+
  - lub H2 (development)
end note

note bottom of printer
  **Opcjonalnie:**
  Drukowanie etykiet QR
  bezposrednio z aplikacji
end note

@enduml
