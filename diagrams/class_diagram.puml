@startuml Class Diagram - QRWare Domain Model

!theme plain
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor<<entity>> LightYellow
    BackgroundColor<<enum>> LightGray
    BackgroundColor<<service>> LightBlue
}

title Diagram Klas - Model Domenowy QRWare

' ==================== ENCJE UZYTKOWNIKOW ====================
package "Modul Uzytkownikow" #DDDDFF {
    
    class User <<entity>> {
        - id: Long
        - username: String
        - email: String
        - password: String
        - firstName: String
        - lastName: String
        - enabled: Boolean
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        --
        + getRoles(): Set<Role>
        + hasPermission(String): Boolean
    }
    
    class Role <<entity>> {
        - id: Long
        - name: String
        - description: String
        - systemRole: Boolean
        --
        + getPermissions(): Set<Permission>
    }
    
    class Permission <<entity>> {
        - id: Long
        - name: String
        - description: String
        - resource: String
        - action: String
    }
    
    User "1" --> "*" Role : ma role
    Role "*" --> "*" Permission : posiada uprawnienia
}

' ==================== ENCJE PRODUKTOW ====================
package "Modul Produktow" #DDFFDD {
    
    class Product <<entity>> {
        - id: Long
        - name: String
        - sku: String
        - barcode: String
        - description: String
        - unitOfMeasure: String
        - price: BigDecimal
        - cost: BigDecimal
        - weight: BigDecimal
        - width: BigDecimal
        - height: BigDecimal
        - depth: BigDecimal
        - minStockLevel: Integer
        - maxStockLevel: Integer
        - reorderPoint: Integer
        - storageConditions: String
        - humidity: BigDecimal
        - active: Boolean
        --
        + getCategory(): Category
        + getInventoryItems(): List<InventoryItem>
    }
    
    class Category <<entity>> {
        - id: Long
        - name: String
        - code: String
        - description: String
        - sortOrder: Integer
        - minTemperature: BigDecimal
        - maxTemperature: BigDecimal
        - minHumidity: BigDecimal
        - maxHumidity: BigDecimal
        --
        + getParent(): Category
        + getChildren(): List<Category>
        + getProducts(): List<Product>
    }
    
    Category "0..1" --> "*" Category : podkategorie
    Product "*" --> "1" Category : nalezy do
}

' ==================== ENCJE MAGAZYNU ====================
package "Modul Magazynu" #FFDDDD {
    
    class Zone <<entity>> {
        - id: Long
        - name: String
        - code: String
        - description: String
        - type: ZoneType
        - temperature: BigDecimal
        - humidity: BigDecimal
        - capacity: Integer
        - active: Boolean
        --
        + getLocations(): List<Location>
    }
    
    class Location <<entity>> {
        - id: Long
        - code: String
        - name: String
        - type: LocationType
        - aisle: String
        - rack: String
        - level: String
        - position: String
        - capacity: Integer
        - maxWeight: BigDecimal
        - active: Boolean
        --
        + getZone(): Zone
        + getInventoryItems(): List<InventoryItem>
    }
    
    enum ZoneType <<enum>> {
        RECEIVING
        STORAGE
        COLD_STORAGE
        SHIPPING
        STAGING
        QUARANTINE
    }
    
    enum LocationType <<enum>> {
        RACK
        SHELF
        BIN
        PALLET
        FLOOR
        STAGING_AREA
    }
    
    Zone "1" --> "*" Location : zawiera
    Zone --> ZoneType
    Location --> LocationType
}

' ==================== ENCJE INWENTARZA ====================
package "Modul Inwentarza" #FFFFDD {
    
    class InventoryItem <<entity>> {
        - id: Long
        - quantity: BigDecimal
        - reservedQuantity: BigDecimal
        - batchNumber: String
        - serialNumber: String
        - receivedDate: LocalDate
        - expirationDate: LocalDate
        - temperature: BigDecimal
        - humidity: BigDecimal
        - status: InventoryStatus
        - qrCode: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        --
        + getProduct(): Product
        + getLocation(): Location
        + getAvailableQuantity(): BigDecimal
    }
    
    class MovementHistory <<entity>> {
        - id: Long
        - movementType: MovementType
        - quantity: BigDecimal
        - quantityBefore: BigDecimal
        - quantityAfter: BigDecimal
        - reason: String
        - reference: String
        - notes: String
        - performedAt: LocalDateTime
        --
        + getInventoryItem(): InventoryItem
        + getFromLocation(): Location
        + getToLocation(): Location
        + getPerformedBy(): User
    }
    
    enum InventoryStatus <<enum>> {
        AVAILABLE
        RESERVED
        DAMAGED
        EXPIRED
        QUARANTINE
        IN_TRANSIT
    }
    
    enum MovementType <<enum>> {
        RECEIPT
        ISSUE
        TRANSFER
        ADJUSTMENT
        RETURN
        DAMAGE
        LOSS
        FOUND
        ORDER_PICK
        ORDER_RECEIPT
        ORDER_ISSUE
    }
    
    InventoryItem "*" --> "1" Product : przechowuje
    InventoryItem "*" --> "1" Location : znajduje sie w
    InventoryItem --> InventoryStatus
    MovementHistory "*" --> "1" InventoryItem : dotyczy
    MovementHistory "*" --> "0..1" Location : z lokalizacji
    MovementHistory "*" --> "0..1" Location : do lokalizacji
    MovementHistory "*" --> "1" User : wykonany przez
    MovementHistory --> MovementType
}

' ==================== ENCJE ZLECEN ====================
package "Modul Zlecen" #DDDDFF {
    
    class Order <<entity>> {
        - id: Long
        - orderNumber: String
        - type: OrderType
        - status: OrderStatus
        - priority: OrderPriority
        - description: String
        - expectedDate: LocalDateTime
        - completedDate: LocalDateTime
        - notes: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        --
        + getCreatedBy(): User
        + getAssignedTo(): User
        + getItems(): List<OrderItem>
        + getStatusHistory(): List<OrderStatusHistory>
        + getCompletionPercentage(): Double
        + isOverdue(): Boolean
    }
    
    class OrderItem <<entity>> {
        - id: Long
        - quantity: BigDecimal
        - pickedQuantity: BigDecimal
        - status: OrderItemStatus
        - notes: String
        --
        + getOrder(): Order
        + getProduct(): Product
        + getSourceLocation(): Location
        + getTargetLocation(): Location
        + getInventoryItem(): InventoryItem
    }
    
    class OrderStatusHistory <<entity>> {
        - id: Long
        - previousStatus: OrderStatus
        - newStatus: OrderStatus
        - notes: String
        - changedAt: LocalDateTime
        --
        + getOrder(): Order
        + getChangedBy(): User
    }
    
    enum OrderType <<enum>> {
        INBOUND
        OUTBOUND
        TRANSFER
        PICK
        PUTAWAY
        CYCLE_COUNT
    }
    
    enum OrderStatus <<enum>> {
        CREATED
        ASSIGNED
        IN_PROGRESS
        PARTIALLY_COMPLETED
        COMPLETED
        CANCELLED
    }
    
    enum OrderPriority <<enum>> {
        LOW
        NORMAL
        HIGH
        URGENT
    }
    
    enum OrderItemStatus <<enum>> {
        PENDING
        IN_PROGRESS
        COMPLETED
        CANCELLED
        SKIPPED
    }
    
    Order "1" --> "*" OrderItem : zawiera
    Order "1" --> "*" OrderStatusHistory : historia
    Order "*" --> "1" User : utworzone przez
    Order "*" --> "0..1" User : przypisane do
    Order --> OrderType
    Order --> OrderStatus
    Order --> OrderPriority
    OrderItem "*" --> "1" Product : dotyczy
    OrderItem "*" --> "0..1" Location : z lokalizacji
    OrderItem "*" --> "0..1" Location : do lokalizacji
    OrderItem --> OrderItemStatus
    OrderStatusHistory --> OrderStatus
    OrderStatusHistory "*" --> "1" User : zmienione przez
}

' ==================== ENCJE QR ====================
package "Modul QR" #FFDDFF {
    
    class QRCodeData <<entity>> {
        - id: Long
        - type: QRCodeType
        - referenceId: Long
        - content: String
        - imagePath: String
        - errorCorrectionLevel: ErrorCorrectionLevel
        - size: Integer
        - generatedAt: LocalDateTime
        --
        + getGeneratedBy(): User
    }
    
    enum QRCodeType <<enum>> {
        PRODUCT
        INVENTORY
        LOCATION
        ORDER
    }
    
    enum ErrorCorrectionLevel <<enum>> {
        L
        M
        Q
        H
    }
    
    QRCodeData --> QRCodeType
    QRCodeData --> ErrorCorrectionLevel
    QRCodeData "*" --> "1" User : wygenerowane przez
}

@enduml
