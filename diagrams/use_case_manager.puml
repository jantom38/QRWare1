@startuml Use Case - Modul Menadzera - Pionowy

top to bottom direction

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightGreen
    BorderColor DarkGreen
}
skinparam rectangle {
    BackgroundColor #F5FFF5
    BorderColor DarkGreen
}

title Diagram Przypadków Użycia\nModuł Menadżera

actor "Menadżer" as Manager #LightGreen

rectangle "System QRWare - Moduł Menadżera" {
    
    package "1. Raportowanie" {
        usecase "UC-M01: Tworzenie raportów\no stanach magazynowych" as UC_M01
        usecase "UC-M07: Podgląd procesów\nlogistycznych" as UC_M07
    }
    
    package "2. Zarządzanie Stanami" {
        ' ZMIANA TUTAJ: Zamiast "Tworzenie" jest "Zarządzanie" (obejmuje edycję/usuwanie)
        usecase "UC-M02: Zarządzanie pozycjami\nmagazynowymi" as UC_M02
        usecase "UC-M05: Generowanie\nkodów QR" as UC_M05
    }
    
    package "3. Zarządzanie Zleceniami" {
        ' SUGESTIA: Tu też warto zmienić na "Zarządzanie", chyba że Menadżer tylko tworzy, a nie może edytować?
        ' Jeśli może edytować/anulować, zostaw "Zarządzanie".
        usecase "UC-M03: Zarządzanie zleceniami\nmagazynowymi" as UC_M03
        usecase "UC-M04: Monitorowanie\nstatusu zleceń" as UC_M04
    }
    
    package "4. Operacje QR" {
        usecase "UC-M06: Skanowanie\nkodów QR" as UC_M06
    }
   
    usecase "Logowanie" as Login
    usecase "Wylogowanie" as Logout
}

' Relacje aktora
Manager --> UC_M01
Manager --> UC_M02
Manager --> UC_M03
Manager --> UC_M04
Manager --> UC_M05
Manager --> UC_M06
Manager --> UC_M07
Manager --> Login
Manager --> Logout

' Relacje logiczne
UC_M02 ..> UC_M05 : <<include>>

' === SEKCJA LAYOUT (Wymuszanie pionu) ===
' Łaczymy ostatni element grupy wyzszej z pierwszym elementem grupy nizszej
UC_M01 -[hidden]-> UC_M02
UC_M02 -[hidden]-> UC_M03
UC_M03 -[hidden]-> UC_M06
' Logowanie na sam dol
UC_M06 -[hidden]-> Login

@enduml