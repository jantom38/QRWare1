@startuml Use Case - Modul Magazyniera - Pionowy

top to bottom direction

skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightYellow
    BorderColor DarkOrange
}
skinparam rectangle {
    BackgroundColor #FFFFF5
    BorderColor DarkOrange
}

title Diagram Przypadków Użycia\nModuł Magazyniera

actor "Magazynier" as Worker #LightYellow

rectangle "System QRWare - Aplikacja Mobilna" {
    
    package "1. Identyfikacja" {
        usecase "UC-W01: Skanowanie kodów QR\n(identyfikacja)" as UC_W01
    }
    
    package "2. Obsługa Zleceń" {
        usecase "UC-W02: Przegląd\nprzypisanych zleceń" as UC_W02
        usecase "UC-W03: Realizacja\nkompletacji (PICK)" as UC_W03
        usecase "UC-W04: Realizacja przyjęcia\ntowaru (INBOUND)" as UC_W04
        usecase "UC-W05: Realizacja wydania\ntowaru (OUTBOUND)" as UC_W05
        usecase "UC-W06: Realizacja\nprzeniesienia (TRANSFER)" as UC_W06
    }
    
    package "3. Operacje Specjalne" {
        usecase "UC-W07: Nieprzewidziane\nprzyjęcie/wydanie" as UC_W07
    }
    
    usecase "Logowanie" as Login
    usecase "Wylogowanie" as Logout
}

' Relacje aktora
Worker --> UC_W01
Worker --> UC_W02
Worker --> UC_W03
Worker --> UC_W04
Worker --> UC_W05
Worker --> UC_W06
Worker --> UC_W07
Worker --> Login
Worker --> Logout

' Relacje miedzy UC
UC_W03 ..> UC_W01 : <<include>>
UC_W04 ..> UC_W01 : <<include>>
UC_W05 ..> UC_W01 : <<include>>
UC_W06 ..> UC_W01 : <<include>>
UC_W07 ..> UC_W01 : <<include>>

' === SEKCJA LAYOUT (Wymuszanie pionu) ===
' Skanowanie na samej górze
UC_W01 -[hidden]-> UC_W02
' Zlecenia nad operacjami specjalnymi
UC_W06 -[hidden]-> UC_W07
' Logowanie na dole
UC_W07 -[hidden]-> Login

@enduml